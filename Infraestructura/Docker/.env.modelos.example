# Opcional: copiar a .env.modelos para cambiar el servidor de anotaciones.
# Docker Desktop permite acceder al CVAT de este PC mediante este nombre.
MODEL_CVAT_URL=http://host.docker.internal:8082/api
MODEL_CVAT_HOST_HEADER=localhost:8082
# Para CVAT remoto por HTTPS, usar su URL /api y dejar HOST_HEADER vacío.
# Las credenciales quedan en Infraestructura/CVAT/acceso_local.json.
# Habilitar con iniciar_panel.ps1 -ConCvat o con compose.modelos.cvat.yml.
# MODEL_CVAT_ACCESS_FILE=../CVAT/acceso_local.json
# MODEL_CVAT_ENABLED=true
